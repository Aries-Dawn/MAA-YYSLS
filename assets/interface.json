{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://github.com/MaaXYZ/MaaFramework/blob/main/docs/zh_cn/3.3-ProjectInterfaceV2%E5%8D%8F%E8%AE%AE.md
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaYYSLS",
    "title": "MaaYYSLS",
    "description": "好像可以自动化？",
    "welcome": "首次使用！欢迎使用 MAA!",
    "icon": "logo.ico",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/Aries-Dawn/MAA-YYSLS",
    "version": "1.0.1",
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        },
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                //"class_regex": ".*",
                "window_regex": "燕云十六声",
                "screencap": "PrintWindow",
                "mouse": "SendMessage",
                "keyboard": "SendMessage"
            },
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "{PROJECT_DIR}/resource"
            ]
        }
    ],
    // 可选的 agent 示例
    // "agent": {
    //     "child_exec": "python",
    //     "child_args": [
    //         "{PROJECT_DIR}/agent/main.py"
    //     ]
    // },
    "task": [
        {
            "name": "太极炸鱼",
            "entry": "太极炸鱼",
            "description": "太极默认使用键盘1，先使用Alt+C调出奇术栏后切换到解密标签即可使用"
        },
        {
            "name": "收集",
            "entry": "采集入口",
            "option": [
                "采集物品信息",
                "有无采集马"
            ]
        },
        {
            "name": "test",
            "entry": "yueKa"
        }
    ],
    "option": {
        "有无采集马": {
            "label": "有没有采集马",
            "type": "switch",
            "default_case": "No",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "采集入口": {
                            "next": [
                                "采集马"
                            ]
                        }
                    },
                    "option": [
                        "采集技能位置"
                    ]
                }
            ]
        },
        "采集技能位置": {
            "label": "技能位置",
            "type": "select",
            "default_case": "Z",
            "cases": [
                {
                    "name": "Z"
                },
                {
                    "name": "1",
                    "pipeline_override": {
                        "在马上": {
                            "action": {
                                "param": {
                                    "key": [
                                        49
                                    ]
                                }
                            }
                        }
                    }
                }
            ]
        },
        "采集物品信息": {
            "type": "input",
            "label": "自定义物品",
            "description": "",
            "inputs": [
                {
                    "name": "识别内容",
                    // "label": "第一个",
                    "description": "自己写捡什么东西，名字分写例如（唐宫羽衣）：\"唐\"",
                    "default": "唐",
                    "pipeline_type": "string",
                    "verify": "^[\u4E00-\u9FA5]+"
                },
                {
                    "name": "识别内容1",
                    // "label": "第二个",
                    "description": "自己写捡什么东西，名字分写例如（唐宫羽衣）：\"宫\"",
                    "default": "宫",
                    "pipeline_type": "string",
                    "verify": "^[\u4E00-\u9FA5]+"
                },
                {
                    "name": "识别内容2",
                    // "label": "第三个",
                    "description": "自己写捡什么东西，名字分写例如（唐宫羽衣）：\"羽\"",
                    "default": "羽",
                    "pipeline_type": "string",
                    "verify": "^[\u4E00-\u9FA5]+"
                }
            ],
            "pipeline_override": {
                "collection_house": {
                    "recognition": {
                        "expected": [
                            "{第一个}",
                            "{第二个}",
                            "{第三个}"
                        ]
                    }
                },
                "collection": {
                    "recognition": {
                        "expected": [
                            "{识别内容}",
                            "{识别内容1}",
                            "{识别内容2}"
                        ]
                    }
                }
            }
        }
    }
}